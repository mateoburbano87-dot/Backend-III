{
  "name": "shipnow",
  "version": "1.0.0",
  "description": "API de ShipNow con arquitectura por capas, mocks, errores, logging, swagger y tests funcionales",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test mocha 'tests/**/*.test.js' --timeout 10000 --exit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^5.1.1",
    "eslint": "^9.5.0",
    "mocha": "^10.6.0",
    "supertest": "^7.0.0"
  }
}